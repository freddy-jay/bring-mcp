# Bring! account credentials (the same ones used in the Bring! app)
BRING_EMAIL=you@example.com

# Optional when the password is in the OS credential store (`bring-mcp set-password`).
# Set here only if you would rather not use the credential store; this takes priority.
# BRING_PASSWORD=your-password

# Optional: name or uuid of the list to use when a tool call omits `list`
# BRING_LIST=Shopping

# Optional: credential store service name the password is filed under
# BRING_KEYRING_SERVICE=bring-mcp

# Optional: DEBUG, INFO, WARNING, ERROR (logs go to stderr)
# BRING_MCP_LOG_LEVEL=INFO

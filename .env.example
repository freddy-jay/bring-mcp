# Bring! account credentials (the same ones used in the Bring! app)
BRING_EMAIL=you@example.com
BRING_PASSWORD=your-password

# Optional: name or uuid of the list to use when a tool call omits `list`
# BRING_LIST=Shopping

# Optional: DEBUG, INFO, WARNING, ERROR (logs go to stderr)
# BRING_MCP_LOG_LEVEL=INFO
